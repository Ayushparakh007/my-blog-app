<%- include("partials/header"); -%>
<style>
  .contact-container {
    max-width: 600px;
    margin: 40px auto;
    padding: 30px;
  }
  .contact-title {
    font-size: 32px;
    font-weight: bold;
    color: #2c3e50;
    margin-bottom: 15px;
    text-align: center;
  }
  .contact-subtitle {
    font-size: 16px;
    color: #7f8c8d;
    text-align: center;
    margin-bottom: 30px;
  }
  .contact-info {
    background: #f8f9fa;
    border-left: 4px solid #3498db;
    padding: 20px;
    margin: 20px 0;
    border-radius: 5px;
  }
  .contact-item {
    display: flex;
    align-items: center;
    margin: 15px 0;
    font-size: 16px;
  }
  .contact-item-icon {
    font-size: 20px;
    margin-right: 15px;
    color: #3498db;
    min-width: 25px;
  }
  .contact-item-text {
    color: #2c3e50;
  }
  .contact-item-text a {
    color: #3498db;
    text-decoration: none;
    font-weight: 500;
  }
  .contact-item-text a:hover {
    text-decoration: underline;
  }
  .contact-note {
    text-align: center;
    color: #7f8c8d;
    font-size: 14px;
    margin-top: 30px;
    font-style: italic;
  }
</style>

