<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <title>Daily Journal - Admin Login</title>
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<style>
  body { background-color: #f7f9fc; }
  .auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px 15px;
  }
  .auth-card {
    width: 100%;
    max-width: 520px;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    border-top: 6px solid #e74c3c;
    padding: 28px;
  }
  .auth-header h2 { margin: 0 0 6px; font-weight: 600; }
  .auth-header p { margin: 0 0 18px; color: #777; }
</style>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header text-center">
      <h2>Admin Login</h2>
      <p>Administration Panel</p>
    </div>

    <% if (typeof error !== 'undefined') { %>
      <div class="alert alert-danger" role="alert" style="margin-bottom: 15px;">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/admin/login">
      <div class="form-group" style="margin-bottom: 15px;">
        <label class="sr-only" for="username">Admin Username</label>
        <div class="input-group input-group-lg">
          <span class="input-group-addon"><span class="glyphicon glyphicon-user"></span></span>
          <input type="text" class="form-control" id="username" name="username" required placeholder="Enter admin username">
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 15px;">
        <label class="sr-only" for="password">Password</label>
        <div class="input-group input-group-lg">
          <span class="input-group-addon"><span class="glyphicon glyphicon-lock"></span></span>
          <input type="password" class="form-control" id="password" name="password" required placeholder="Enter admin password">
        </div>
      </div>

      <button type="submit" class="btn btn-danger btn-lg btn-block">Login as Admin</button>
    </form>

    <hr style="margin: 20px 0;">

    <p class="text-center" style="margin-bottom: 8px;">
      Don't have an admin account? <a href="/admin/register">Register here</a>
    </p>
    <p class="text-center" style="margin: 0;">
      <small class="text-muted">Regular user? <a href="/user/login">Login as User</a></small>
    </p>
  </div>
</div>

</body>
</html>
